# Copy to .env.local and fill in. Never commit the real values.

# The Gmail account that sends the email.
GMAIL_USER=you@gmail.com

# 16-character App Password (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# Optional: where the plan is delivered. Defaults to GMAIL_USER.
NOTIFY_EMAIL=
